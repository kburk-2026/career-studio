# Copy to .env (git-ignored) and fill in from Supabase: Project Settings -> API Keys / Data API.
# Never paste these into chat or commit them.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
# Bypasses row-level security. Local scripts only (import, pull). Never put this in Vercel.
SUPABASE_SERVICE_ROLE_KEY=
# The one email allowed to sign in.
ALLOWED_EMAIL=you@example.com
