{
  "name": "career-studio",
  "version": "0.1.0",
  "private": true,
  "description": "A private job-search dashboard and evidence-grounded AI interview coach.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "node scripts/check_privacy.mjs",
    "check:rls": "node scripts/rls_check.mjs",
    "eval": "node evals/review.eval.mjs && node evals/answer.eval.mjs",
    "eval:answers": "node evals/answer.eval.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "docx": "9.15.0",
    "mammoth": "1.13.0"
  }
}
