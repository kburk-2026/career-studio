{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        }
      ]
    }
  ],
  "functions": {
    "api/generate.js": {
      "maxDuration": 300
    },
    "api/review.js": {
      "maxDuration": 120
    },
    "api/answer.js": {
      "maxDuration": 120
    },
    "api/upload.js": {
      "maxDuration": 120
    },
    "api/build.js": {
      "maxDuration": 300
    },
    "api/coach.js": {
      "maxDuration": 120
    }
  }
}
